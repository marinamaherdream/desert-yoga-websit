    <script>
        // Mobile Navigation Toggle
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Filter Packages
        function filterRetreats(category) {
            const cards = document.querySelectorAll('.retreat-card');
            const buttons = document.querySelectorAll('.package-filter-btn');

            buttons.forEach(btn => {
                btn.classList.remove('bg-gold', 'text-bronze-dark', 'border-gold');
                btn.classList.add('bg-bronze/50', 'text-gray-300', 'border-white/20');
            });

            event.target.classList.remove('bg-bronze/50', 'text-gray-300', 'border-white/20');
            event.target.classList.add('bg-gold', 'text-bronze-dark', 'border-gold');

            cards.forEach(card => {
                if (category === 'all' || card.classList.contains(category)) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // FAQ Toggle
        function toggleFAQ(id) {
            const content = document.getElementById(`faq-content-${id}`);
            const icon = document.getElementById(`faq-icon-${id}`);

            if (content.classList.contains('hidden')) {
                content.classList.remove('hidden');
                icon.classList.remove('fa-plus');
                icon.classList.add('fa-minus');
            } else {
                content.classList.add('hidden');
                icon.classList.remove('fa-minus');
                icon.classList.add('fa-plus');
            }
        }

        // Booking Modal Logic
        function openBookingModal(packageName = null, basePrice = null) {
            const modal = document.getElementById('bookingModal');
            const packageSelect = document.getElementById('calc-package');

            if (packageName) {
                for (let i = 0; i < packageSelect.options.length; i++) {
                    if (packageSelect.options[i].text.includes(packageName) || packageSelect.options[i].value == basePrice) {
                        packageSelect.selectedIndex = i;
                        break;
                    }
                }
            }
            calculateModalPrice();
            modal.classList.remove('hidden');
        }

        function closeBookingModal() {
            document.getElementById('bookingModal').classList.add('hidden');
        }

        function calculateModalPrice() {
            const packagePrice = parseInt(document.getElementById('calc-package').value) || 0;
            const guests = parseInt(document.getElementById('calc-guests').value) || 1;
            const roomSurcharge = parseInt(document.getElementById('calc-room').value) || 0;

            let addOnsTotal = 0;
            if (document.getElementById('addon-horse').checked) addOnsTotal += parseInt(document.getElementById('addon-horse').value);
            if (document.getElementById('addon-massage').checked) addOnsTotal += parseInt(document.getElementById('addon-massage').value);
            if (document.getElementById('addon-sound').checked) addOnsTotal += parseInt(document.getElementById('addon-sound').value);

            const grandTotal = (packagePrice + roomSurcharge + addOnsTotal) * guests;
            document.getElementById('modal-total-display').innerText = `$ ${grandTotal.toLocaleString()}`;
        }

        function handleModalSubmit(e) {
            e.preventDefault();
            alert('Thank you! Your booking inquiry for Desert Yoga Retreat has been received. Our team will contact you via email shortly with complete transfer and reservation details.');
            closeBookingModal();
        }
    </script>
